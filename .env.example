# ============================================
# 环境变量配置示例
# Environment Variables Configuration Example
# ============================================

# ──────────────────────────────────────────────
# 🔐 管理后台认证 / Admin Authentication
# ──────────────────────────────────────────────
# 用于保护所有 /api/nodes 相关接口（GET/POST/PUT/DELETE）
# 请求必须携带 Authorization: Bearer <ADMIN_TOKEN> 头
# For protecting all /api/nodes endpoints (GET/POST/PUT/DELETE)
# Requests must include Authorization: Bearer <ADMIN_TOKEN> header

ADMIN_TOKEN=your-secure-admin-token-here-change-me

# ──────────────────────────────────────────────
# 🤖 Gemini AI 配置 / Gemini AI Configuration
# ──────────────────────────────────────────────
# 用于 /api/chat 端点的 AI 对话功能
# 在 https://aistudio.google.com/apikey 获取
# For /api/chat endpoint AI conversation feature
# Get from https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# ──────────────────────────────────────────────
# 🌐 CORS 配置 / CORS Configuration
# ──────────────────────────────────────────────
# /api/chat 接口允许的来源（逗号分隔）
# 默认值：https://hou.wsnail.com,https://wsnail.com
# Allowed origins for /api/chat endpoint (comma-separated)
# Default: https://hou.wsnail.com,https://wsnail.com

CHAT_ALLOWED_ORIGINS=https://hou.wsnail.com,https://wsnail.com

# ──────────────────────────────────────────────
# 🚦 速率限制 (可选) / Rate Limiting (Optional)
# ──────────────────────────────────────────────
# 如果需要 /api/chat 速率限制功能，需要在 wrangler.toml 中配置 KV 命名空间
# 并绑定到 RATE_LIMIT_KV
# 当前配置：每 IP 每分钟最多 20 次请求
# If rate limiting is needed for /api/chat, configure KV namespace in wrangler.toml
# and bind it to RATE_LIMIT_KV
# Current setting: max 20 requests per IP per minute

# [[kv_namespaces]]
# binding = "RATE_LIMIT_KV"
# id = "your-kv-namespace-id"
# preview_id = "your-preview-kv-namespace-id"

# ──────────────────────────────────────────────
# 🐍 Flask 服务配置 / Flask Server Configuration
# (用于 opencode-server/server.py)
# ──────────────────────────────────────────────
# Flask 绑定地址（默认：127.0.0.1，仅本地访问）
# Flask host (default: 127.0.0.1, local only)

FLASK_HOST=127.0.0.1

# Flask 端口（默认：3007）
# Flask port (default: 3007)

FLASK_PORT=3007

# Flask 调试模式（默认：false，生产环境应设为 false）
# Flask debug mode (default: false, should be false in production)

FLASK_DEBUG=false
